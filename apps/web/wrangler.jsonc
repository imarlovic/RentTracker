{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "renttracker",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "renttracker",
      "database_id": "545676db-5636-4859-b3fe-b02bbea8ec48",
      "migrations_dir": "./migrations"
    }
  ],
  "triggers": {
    // Sync linked Airbnb/Booking iCal feeds every 15 minutes
    "crons": ["*/15 * * * *"]
  },
  // Paid Workers default is higher; free plans remain capped at 50 external subrequests.
  "limits": {
    "subrequests": 10000
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "658207955903-gh23kfhhir9s6u6tsn5rqnkqsck12pss.apps.googleusercontent.com",
    "JWT_ISSUER": "renttracker",
    "JWT_AUDIENCE": "renttracker-web"
  }
}
